# WorksAuto Environment Configuration
PORT=4000
NODE_ENV=development
APP_BASE_URL="http://localhost:3000"

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://worksauto:worksauto_secret_2026@localhost:5432/worksauto_db?schema=public"
SYSTEM_DATABASE_URL="postgresql://worksauto:worksauto_secret_2026@localhost:5432/worksauto_db?schema=public"

# Redis (Caching & Idempotency)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# JWT Authentication & Token Rotation
JWT_SECRET="worksauto_super_secret_jwt_key_2026_production_grade"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="30d"

# MinIO S3 Object Storage
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="worksauto_minio"
MINIO_SECRET_KEY="worksauto_minio_2026"
MINIO_BUCKET="worksauto-photos"

# S3 / MinIO Configuration
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="worksauto_minio"
S3_SECRET_KEY="worksauto_minio_2026"
S3_BUCKET_NAME="worksauto-media"
